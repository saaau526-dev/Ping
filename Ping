-- =================================================================================
-- INDEPENDENT REALTIME SYNCED PING DISPLAY (BOTTOM RIGHT)
-- =================================================================================

local Players = game:GetService("Players")
local Player = Players.LocalPlayer

-- 1. GUIの構築 (既存のScreenGui、または新規生成)
local ScreenGui = Player:WaitForChild("PlayerGui"):FindFirstChild("ModernCombatUI")
if not ScreenGui then
	ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "ModernCombatUI"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.Parent = Player.PlayerGui
else
	ScreenGui.ResetOnSpawn = false
end

-- 既存のPingGUIがあれば重複防止のために削除
local existingPingUI = ScreenGui:FindFirstChild("PingDisplayUI")
if existingPingUI then existingPingUI:Destroy() end

-- Ping表示専用のメインフレーム（画面右下に固定）
local PingFrame = Instance.new("Frame")
PingFrame.Name = "PingDisplayUI"
PingFrame.Size = UDim2.new(0, 110, 0, 32)
PingFrame.Position = UDim2.new(1, -120, 1, -45) -- 画面右下に配置
PingFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
PingFrame.BorderSizePixel = 0
PingFrame.Active = false
PingFrame.Parent = ScreenGui

local PingCorner = Instance.new("UICorner", PingFrame)
PingCorner.CornerRadius = UDim.new(0, 6)
local PingStroke = Instance.new("UIStroke", PingFrame)
PingStroke.Color = Color3.fromRGB(70, 70, 80)
PingStroke.Thickness = 1.5

-- Pingテキストラベル
local PingLabel = Instance.new("TextLabel", PingFrame)
PingLabel.Size = UDim2.new(1, 0, 1, 0)
PingLabel.BackgroundTransparency = 1
PingLabel.Text = "Ping: -- ms"
PingLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
PingLabel.Font = Enum.Font.GothamBold
PingLabel.TextSize = 12

-- Roblox公式と同じ正確な往復Ping（GetNetworkPing）を取得して更新
task.spawn(function()
	while true do
		local success, pingVal = pcall(function()
			-- :GetNetworkPing() は秒単位の片道のため、* 2000 をすることで公式の往復ミリ秒（ms）に一致させます
			return math.floor((Player:GetNetworkPing() * 2000) + 0.5)
		end)
		
		if success and pingVal then
			PingLabel.Text = "Ping: " .. pingVal .. " ms"
			
			-- ネットワーク状態に応じた色の変更
			if pingVal < 100 then
				PingLabel.TextColor3 = Color3.fromRGB(100, 255, 120) -- 緑 (良好)
			elseif pingVal < 250 then
				PingLabel.TextColor3 = Color3.fromRGB(255, 200, 100) -- 黄 (注意)
			else
				PingLabel.TextColor3 = Color3.fromRGB(255, 100, 100) -- 赤 (重い)
			end
		else
			PingLabel.Text = "Ping: N/A"
			PingLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		end
		
		task.wait(1) -- 1秒ごとに更新
	end
end)
